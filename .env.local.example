# Sanity CMS — required for the blog and the /studio admin dashboard
# Get these by running `npx sanity init` in this project, or from
# https://www.sanity.io/manage after creating a free project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# YouTube — required for the video grid and /bidiyo page to show real videos
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEWSLETTER_FROM_EMAIL=your_verified_sender@example.com
NEWSLETTER_NOTIFY_EMAIL=example@mail.com
